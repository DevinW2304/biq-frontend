# Copy to .env.local for development; set the same names in Vercel for deploys.

# The BIQ API (biq-backend). Required outside local development: without it
# every request goes to http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Canonical origin for sitemap, canonical links and share images. Defaults to
# https://biq-mind.vercel.app; set it when the site moves to a custom domain.
NEXT_PUBLIC_SITE_URL=
